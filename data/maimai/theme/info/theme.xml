<Theme>
    <Container id="main" width="800" height="800" background="background.png" direction="column" justify-content="space-between">
        <Container id="upper" justify-content="center" width="800" padding="0" direction="column" align-content="center" margin="-24 0 0 0">
            <Container id="header" width="704" height="227" background="info_bg.png" direction="column">
                <Image id="cover" width="704" height="227" stretch="true" mask="header_mask.png" opacity="0.15" margin="0 -227 0 0"/>
                <Container id="wrapper" width="704" padding="26">
                    <Image id="cover" width="175" height="175" stretch="true" mask="cover_mask.png"/>
                    <Container id="right" height="180" direction="column" justify-content="space-between" margin="0 0 20 0">
                        <Container id="top">
                            <Image id="type" margin="0 0 0 7"/>
                            <Text id="id" size="18" font="Alibaba-PuHuiTi-H" color="#ffffff" margin="-1 0 0 0"/>
                        </Container>
                        <Container id="title-container" justify-content="center" direction="column" height="100" margin="-2 0 0 0">
                            <Text id="title" size="46" font="Alibaba-PuHuiTi-H" color="#ffffff"/>
                            <Text id="artist" size="18" font="Alibaba-PuHuiTi-H" color="#ffffff" margin="8 0 0 0"/>
                        </Container>
                        <Image id="divider" src="divider.png"/>
                        <Container id="bottom" margin="4 0 0 0">
                            <Image id="genre" margin="0 0 0 8"/>
                            <Image id="version" margin="0 0 0 8"/>
                            <Text id="bpm" size="18" font="Alibaba-PuHuiTi-H" color="#ffffff" margin="5 0 0 0"/>
                        </Container>
                    </Container>
                </Container>
            </Container>
        </Container>
        <Container id="footer" justify-content="center" padding="12" color="#013162">
            <Text id="copyright" size="22" font="Alibaba-PuHuiTi-H" color="#ffffff" shadow="1">可怜Bot 9.0 by 心水湛清 617 | https://bot-docs.otmdb.cn</Text>
        </Container>
    </Container>
    <Container id="chart" width="708" height="79" justify-content="space-between" align-content="center" padding="1 0 18 22" margin="6 0 2 0">
        <Container id="level-container" width="43" height="43" background="level_bg.png" direction="column" justify-content="center" align-content="center" padding="2 1 1 1">
            <Text id="icon" size="12" font="Alibaba-PuHuiTi-H">LV</Text>
            <Text id="level" size="18" font="Alibaba-PuHuiTi-H" margin="-4 0 0 0">-</Text>
        </Container>
        <Container id="fixed-acc" width="140" justify-content="start" margin="-1 0 -2 2">
            <Text id="achievement" size="24" font="Alibaba-PuHuiTi-H" color="#ffffff" margin="0 0 12 0">暂无记录</Text>
        </Container>
        <Container id="fixed-rank" width="77" justify-content="center">
            <Image id="rank" src="rank_none.png"/>
        </Container>
        <Image id="combo" src="icon_blank.png"/>
        <Image id="sync" src="icon_blank.png"/>
        <Container id="dxstar-container" direction="column" justify-content="center" align-content="center" margin="0 0 0 3">
            <Text id="value" size="16" font="Alibaba-PuHuiTi-H" color="#ffffff"> </Text>
            <Image id="icon" src="icon_dxstar_0.png"/>
        </Container>
        <Container id="note-designer" width="194" height="42" background="note_designer_bg.png" direction="column" justify-content="center" align-content="center">
            <Text id="designer" size="24" font="Alibaba-PuHuiTi-H" color="#ffffff">-</Text>
        </Container>
    </Container>
    <Container id="extra">
        <Text font="FZLTHProGBK Heavy"/>
    </Container>
</Theme>
