<Theme>
    <Container id="main" width="1280" min-height="1280" stretch="true" background="background.png" direction="column" justify-content="space-between">
        <Container id="upper" width="1280" padding="48" direction="column">
            <Container id="header" min-height="116" margin="-20 0 0 0">
                <Text id="title" size="36" font="Alibaba-PuHuiTi-H" color="#fbf8e9" border="12 #e84472" shadow="1 0.2" margin="36 0 0 0"></Text>
                <Image id="all" />
            </Container>
            <Container id="list" direction="column" margin="16 0 -2 0">
            </Container>
        </Container>
        <Container id="footer" justify-content="center" padding="12" color="#013162">
            <Text id="copyright" size="22" font="Alibaba-PuHuiTi-H" color="#ffffff" shadow="1">可怜Bot 9.0 by 心水湛清 617 | https://bot-docs.otmdb.cn</Text>
        </Container>
    </Container>

    <Container id="group" margin="0 12 0 0">
        <Container width="80" height="80" justify-content="center" background="level.png" padding="26 0 18 0" margin="0 0 14 14">
            <Text id="level" size="22" font="Alibaba-PuHuiTi-H" color="#ffffff"></Text>
        </Container>
        <Container id="musics" width="1120" wrap="wrap" margin="0 0 3 0">
        </Container>
    </Container>
    <Container id="music" width="80" height="80" color="#9f51dc" padding="4" margin="0 8 4 4">
        <Container id="cover" width="72" height="72" direction="column" justify-content="space-between" background="101.png">
            <Container id="info" justify-content="space-between" width="72">
                <Image id="type" src="type_DX.png"></Image>
                <Container id="id-container" width="25" justify-content="center" color="#9f51dc" margin="-2 0 0 -4" padding="0 2 0 0">
                    <Text id="id" size="10" font="Alibaba-PuHuiTi-H" color="#ffffff">101</Text>
                </Container>
            </Container>
            <Container justify-content="center" width="72" margin="-11 0 0 0">
                <Image id="score"></Image>
            </Container>
            <Container>
            </Container>
        </Container>
    </Container>
</Theme>
